# PostgreSQL connection string. Keep real secrets out of Git.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/briqona"

# Set to a long random value in your deployment environment.
SESSION_SECRET="replace-with-a-long-random-secret"

# Public application URL used for Stripe Checkout redirects.
APP_URL="https://app.example.com"

# Stripe test/live credentials belong in deployment secrets, never Git.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
